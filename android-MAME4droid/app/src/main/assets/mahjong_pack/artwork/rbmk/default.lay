<?xml version="1.0"?>
<mamelayout version="2">
    <!-- rbmk KEY4（以实机为准，与 MAME 字段名不一致）：加倍=16；大=4；小=2；得分=32 -->
    <element name="bg_panel"> <image file="bg.png" /> </element>

    <element name="button_start_donden"> <image file="start_donden_up.png" state="0" /> <image file="start_donden_down.png" state="1" /> </element>
    <element name="button_double"> <image file="double_up.png" state="0" /> <image file="double_down.png" state="1" /> </element>
    <element name="button_big"> <image file="big_up.png" state="0" /> <image file="big_down.png" state="1" /> </element>
    <element name="button_small"> <image file="small_up.png" state="0" /> <image file="small_down.png" state="1" /> </element>
    <element name="button_take"> <image file="take_up.png" state="0" /> <image file="take_down.png" state="1" /> </element>
    <element name="button_keyin"> <image file="keyin_up.png" state="0" /> <image file="keyin_down.png" state="1" /> </element>
    <element name="button_bet"> <image file="bet_up.png" state="0" /> <image file="bet_down.png" state="1" /> </element>
    <element name="button_chi"> <image file="chi_up.png" state="0" /> <image file="chi_down.png" state="1" /> </element>
    <element name="button_pon"> <image file="pon_up.png" state="0" /> <image file="pon_down.png" state="1" /> </element>
    <element name="button_kan"> <image file="kan_up.png" state="0" /> <image file="kan_down.png" state="1" /> </element>
    <element name="button_reach"> <image file="reach_up.png" state="0" /> <image file="reach_down.png" state="1" /> </element>
    <element name="button_ron"> <image file="ron_up.png" state="0" /> <image file="ron_down.png" state="1" /> </element>
    
    <element name="lamp_chi_glow"> <image file="chi_glow.png" /> </element>
    <element name="lamp_pon_glow"> <image file="pon_glow.png" /> </element>
    <element name="lamp_kan_glow"> <image file="kan_glow.png" /> </element>
    <element name="lamp_reach_glow"> <image file="reach_glow.png" /> </element>
    <element name="lamp_ron_glow"> <image file="ron_glow.png" /> </element>

    <element name="button_a"> <image file="a_up.png" state="0" /> <image file="a_down.png" state="1" /> </element>
    <element name="button_b"> <image file="b_up.png" state="0" /> <image file="b_down.png" state="1" /> </element>
    <element name="button_c"> <image file="c_up.png" state="0" /> <image file="c_down.png" state="1" /> </element>
    <element name="button_d"> <image file="d_up.png" state="0" /> <image file="d_down.png" state="1" /> </element>
    <element name="button_e"> <image file="e_up.png" state="0" /> <image file="e_down.png" state="1" /> </element>
    <element name="button_f"> <image file="f_up.png" state="0" /> <image file="f_down.png" state="1" /> </element>
    <element name="button_g"> <image file="g_up.png" state="0" /> <image file="g_down.png" state="1" /> </element>
    <element name="button_h"> <image file="h_up.png" state="0" /> <image file="h_down.png" state="1" /> </element>
    <element name="button_i"> <image file="i_up.png" state="0" /> <image file="i_down.png" state="1" /> </element>
    <element name="button_j"> <image file="j_up.png" state="0" /> <image file="j_down.png" state="1" /> </element>
    <element name="button_k"> <image file="k_up.png" state="0" /> <image file="k_down.png" state="1" /> </element>
    <element name="button_l"> <image file="l_up.png" state="0" /> <image file="l_down.png" state="1" /> </element>
    <element name="button_m"> <image file="m_up.png" state="0" /> <image file="m_down.png" state="1" /> </element>
    <element name="button_n"> <image file="n_up.png" state="0" /> <image file="n_down.png" state="1" /> </element>

    <element name="touch_a"> <image file="touch_up.png" state="0" /> <image file="touch_down.png" state="1" /> </element>
    <element name="touch_b"> <image file="touch_up.png" state="0" /> <image file="touch_down.png" state="1" /> </element>
    <element name="touch_c"> <image file="touch_up.png" state="0" /> <image file="touch_down.png" state="1" /> </element>
    <element name="touch_d"> <image file="touch_up.png" state="0" /> <image file="touch_down.png" state="1" /> </element>
    <element name="touch_e"> <image file="touch_up.png" state="0" /> <image file="touch_down.png" state="1" /> </element>
    <element name="touch_f"> <image file="touch_up.png" state="0" /> <image file="touch_down.png" state="1" /> </element>
    <element name="touch_g"> <image file="touch_up.png" state="0" /> <image file="touch_down.png" state="1" /> </element>
    <element name="touch_h"> <image file="touch_up.png" state="0" /> <image file="touch_down.png" state="1" /> </element>
    <element name="touch_i"> <image file="touch_up.png" state="0" /> <image file="touch_down.png" state="1" /> </element>
    <element name="touch_j"> <image file="touch_up.png" state="0" /> <image file="touch_down.png" state="1" /> </element>
    <element name="touch_k"> <image file="touch_up.png" state="0" /> <image file="touch_down.png" state="1" /> </element>
    <element name="touch_l"> <image file="touch_up.png" state="0" /> <image file="touch_down.png" state="1" /> </element>
    <element name="touch_m"> <image file="touch_up.png" state="0" /> <image file="touch_down.png" state="1" /> </element>
    <element name="touch_n"> <image file="touch_up.png" state="0" /> <image file="touch_down.png" state="1" /> </element>

    <element name="hint_haidi_n"> <image file="hint_haidi_n.png" /> </element>
    <element name="hint_duihua_n"> <image file="hint_duihua_n.png" /> </element>
    <element name="hint_bibei_a"> <image file="hint_bibei_a.png" /> </element>
    <element name="hint_bibei_c"> <image file="hint_bibei_c.png" /> </element>
    <element name="hint_bibei_e"> <image file="hint_bibei_e.png" /> </element>
    <element name="hint_bibei_g"> <image file="hint_bibei_g.png" /> </element>
    <element name="hint_bibei_m"> <image file="hint_bibei_m.png" /> </element>
    <element name="hint_bibei_n"> <image file="hint_bibei_n.png" /> </element>

    <!-- 透视套件：不绑 inputtag，避免占麻将键（退币/海底/吃）；点按由 Lua 处理 -->
    <element name="btn_peek">
        <image file="peek_up.png" state="0" />
        <image file="peek_down.png" state="1" />
    </element>
    <element name="btn_mark">
        <image file="mark_up.png" state="0" />
        <image file="mark_down.png" state="1" />
    </element>
    <element name="btn_pause">
        <image file="pause_up.png" state="0" />
        <image file="continue_up.png" state="1" />
    </element>

    <view name="Portrait_2_Rows">
        <!-- 必须写死画幅，否则屏外的 btn_mark(x=2000) 会把 View 撑宽，竖屏窗口右边一大块黑 -->
        <bounds x="0" y="0" width="1000" height="1640" />
        <screen index="0"> <bounds x="0" y="0" width="1000" height="970" /> </screen>
        <element ref="bg_panel"> <bounds x="0" y="970" width="1000" height="670" /> </element>
        
        <element ref="button_start_donden" inputtag="KEY0" inputmask="2"> <bounds x="3" y="980" width="142" height="130" /> </element>
        <element ref="button_double" inputtag="KEY4" inputmask="16"> <bounds x="145" y="980" width="142" height="130" /> </element>
        <element ref="button_big" inputtag="KEY4" inputmask="4"> <bounds x="287" y="980" width="142" height="130" /> </element>
        <element ref="button_small" inputtag="KEY4" inputmask="2"> <bounds x="429" y="980" width="142" height="130" /> </element>
        <element ref="button_take" inputtag="KEY4" inputmask="32"> <bounds x="571" y="980" width="142" height="130" /> </element>
        <element ref="button_keyin" inputtag="IN1" inputmask="512"> <bounds x="713" y="980" width="142" height="130" /> </element>
        <element ref="button_bet" inputtag="KEY1" inputmask="2"> <bounds x="855" y="980" width="142" height="130" /> </element>

        <element ref="button_pon" inputtag="KEY3" inputmask="8"> <bounds x="145" y="1110" width="142" height="130" /> </element>
        <element ref="button_kan" inputtag="KEY0" inputmask="4"> <bounds x="287" y="1110" width="142" height="130" /> </element>
        <element ref="button_reach" inputtag="KEY1" inputmask="4"> <bounds x="571" y="1110" width="142" height="130" /> </element>
        <element ref="button_ron" inputtag="KEY2" inputmask="4"> <bounds x="713" y="1110" width="142" height="130" /> </element>
        <!-- 透视/暂停：不绑麻将键（点按由 Lua 指针处理，避免退币/洗分） -->
        <element ref="btn_peek" id="btn_peek"> <bounds x="3" y="1110" width="142" height="130" /> </element>
        <element ref="btn_pause" id="btn_pause"> <bounds x="855" y="1110" width="142" height="130" /> </element>
        <element ref="btn_mark" id="btn_mark"> <bounds x="2000" y="0" width="142" height="130" /> </element>

        <element ref="lamp_pon_glow" id="lamp_pon">
            <bounds x="145" y="1110" width="142" height="130" /> 
            <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" />
        </element>
        <element ref="lamp_kan_glow" id="lamp_kan">
            <bounds x="287" y="1110" width="142" height="130" /> 
            <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" />
        </element>
        <element ref="lamp_reach_glow" id="lamp_reach">
            <bounds x="571" y="1110" width="142" height="130" /> 
            <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" />
        </element>
        <element ref="lamp_ron_glow" id="lamp_ron">
            <bounds x="713" y="1110" width="142" height="130" /> 
            <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" />
        </element>

        <element ref="button_a" inputtag="KEY0" inputmask="64"> <bounds x="3" y="1240" width="142" height="200" /> </element>
        <element ref="button_b" inputtag="KEY1" inputmask="64"> <bounds x="145" y="1240" width="142" height="200" /> </element>
        <element ref="button_c" inputtag="KEY2" inputmask="64"> <bounds x="287" y="1240" width="142" height="200" /> </element>
        <element ref="button_d" inputtag="KEY3" inputmask="64"> <bounds x="429" y="1240" width="142" height="200" /> </element>
        <element ref="button_e" inputtag="KEY0" inputmask="32"> <bounds x="571" y="1240" width="142" height="200" /> </element>
        <element ref="button_f" inputtag="KEY1" inputmask="32"> <bounds x="713" y="1240" width="142" height="200" /> </element>
        <element ref="button_g" inputtag="KEY2" inputmask="32"> <bounds x="855" y="1240" width="142" height="200" /> </element>

        <element ref="button_h" inputtag="KEY3" inputmask="32"> <bounds x="3" y="1440" width="142" height="200" /> </element>
        <element ref="button_i" inputtag="KEY0" inputmask="16"> <bounds x="145" y="1440" width="142" height="200" /> </element>
        <element ref="button_j" inputtag="KEY1" inputmask="16"> <bounds x="287" y="1440" width="142" height="200" /> </element>
        <element ref="button_k" inputtag="KEY2" inputmask="16"> <bounds x="429" y="1440" width="142" height="200" /> </element>
        <element ref="button_l" inputtag="KEY3" inputmask="16"> <bounds x="571" y="1440" width="142" height="200" /> </element>
        <element ref="button_m" inputtag="KEY0" inputmask="8"> <bounds x="713" y="1440" width="142" height="200" /> </element>
        <element ref="button_n" inputtag="KEY1" inputmask="8"> <bounds x="855" y="1440" width="142" height="200" /> </element>

        <element ref="hint_haidi_n" id="lamp_hint_haidi">
            <bounds x="855" y="1440" width="142" height="200" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> 
        </element>
        <element ref="hint_duihua_n" id="lamp_hint_duihua">
            <bounds x="855" y="1440" width="142" height="200" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> 
        </element>
        <element ref="hint_bibei_a" id="lamp_hint_bibei">
            <bounds x="3" y="1240" width="142" height="200" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> 
        </element>
        <element ref="hint_bibei_c" id="lamp_hint_bibei__1">
            <bounds x="287" y="1240" width="142" height="200" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> 
        </element>
        <element ref="hint_bibei_e" id="lamp_hint_bibei__2">
            <bounds x="571" y="1240" width="142" height="200" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> 
        </element>
        <element ref="hint_bibei_g" id="lamp_hint_bibei__3">
            <bounds x="855" y="1240" width="142" height="200" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> 
        </element>
        <element ref="hint_bibei_m" id="lamp_hint_bibei__4">
            <bounds x="713" y="1440" width="142" height="200" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> 
        </element>
        <element ref="hint_bibei_n" id="lamp_hint_bibei__5">
            <bounds x="855" y="1440" width="142" height="200" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> 
        </element>
    </view>

    <view name="Landscape_Touch_Screen">
        <bounds x="0" y="0" width="1600" height="900" />
        <screen index="0"> <bounds x="200" y="0" width="1200" height="900" /> </screen>

        <element ref="button_start_donden" inputtag="KEY0" inputmask="2"> <bounds x="58" y="250" width="142" height="130" /> </element>
        <element ref="button_bet" inputtag="KEY1" inputmask="2"> <bounds x="58" y="380" width="142" height="130" /> </element>
        <element ref="button_keyin" inputtag="IN1" inputmask="512"> <bounds x="58" y="510" width="142" height="130" /> </element>
        <element ref="button_double" inputtag="KEY4" inputmask="16"> <bounds x="58" y="640" width="142" height="87" /> </element>
        <element ref="button_big" inputtag="KEY4" inputmask="4"> <bounds x="58" y="727" width="142" height="87" /> </element>
        <element ref="button_small" inputtag="KEY4" inputmask="2"> <bounds x="58" y="814" width="142" height="86" /> </element>

        <!-- 右栏：无吃；得分占原吃位；碰/杠/听/胡。上方透视/暂停（不绑麻将键） -->
        <element ref="btn_peek" id="btn_peek"> <bounds x="1400" y="10" width="142" height="115" /> </element>
        <element ref="btn_pause" id="btn_pause"> <bounds x="1400" y="130" width="142" height="115" /> </element>
        <element ref="btn_mark" id="btn_mark"> <bounds x="2000" y="0" width="142" height="115" /> </element>
        <element ref="button_take" inputtag="KEY4" inputmask="32"> <bounds x="1400" y="250" width="142" height="130" /> </element>
        <element ref="button_pon" inputtag="KEY3" inputmask="8"> <bounds x="1400" y="380" width="142" height="130" /> </element>
        <element ref="button_kan" inputtag="KEY0" inputmask="4"> <bounds x="1400" y="510" width="142" height="130" /> </element>
        <element ref="button_reach" inputtag="KEY1" inputmask="4"> <bounds x="1400" y="640" width="142" height="130" /> </element>
        <element ref="button_ron" inputtag="KEY2" inputmask="4"> <bounds x="1400" y="770" width="142" height="130" /> </element>

        <element ref="lamp_ron_glow" id="lamp_ron">
            <bounds x="1400" y="770" width="142" height="130" /> 
            <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" />
        </element>
        <element ref="lamp_reach_glow" id="lamp_reach">
            <bounds x="1400" y="640" width="142" height="130" /> 
            <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" />
        </element>
        <element ref="lamp_kan_glow" id="lamp_kan">
            <bounds x="1400" y="510" width="142" height="130" /> 
            <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" />
        </element>
        <element ref="lamp_pon_glow" id="lamp_pon">
            <bounds x="1400" y="380" width="142" height="130" /> 
            <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" />
        </element>

        <!-- 横版字母：512x256 屏内 A(24,224) 31x24、间距1、M(408,224)、N(456,224)；layout=screen(200,0,1200x900) -->
        <element ref="touch_a" inputtag="KEY0" inputmask="64"> <bounds x="256.25" y="787.5" width="72.65625" height="84.375" /> </element>
        <element ref="touch_b" inputtag="KEY1" inputmask="64"> <bounds x="331.25" y="787.5" width="72.65625" height="84.375" /> </element>
        <element ref="touch_c" inputtag="KEY2" inputmask="64"> <bounds x="406.25" y="787.5" width="72.65625" height="84.375" /> </element>
        <element ref="touch_d" inputtag="KEY3" inputmask="64"> <bounds x="481.25" y="787.5" width="72.65625" height="84.375" /> </element>
        <element ref="touch_e" inputtag="KEY0" inputmask="32"> <bounds x="556.25" y="787.5" width="72.65625" height="84.375" /> </element>
        <element ref="touch_f" inputtag="KEY1" inputmask="32"> <bounds x="631.25" y="787.5" width="72.65625" height="84.375" /> </element>
        <element ref="touch_g" inputtag="KEY2" inputmask="32"> <bounds x="706.25" y="787.5" width="72.65625" height="84.375" /> </element>
        <element ref="touch_h" inputtag="KEY3" inputmask="32"> <bounds x="781.25" y="787.5" width="72.65625" height="84.375" /> </element>
        <element ref="touch_i" inputtag="KEY0" inputmask="16"> <bounds x="856.25" y="787.5" width="72.65625" height="84.375" /> </element>
        <element ref="touch_j" inputtag="KEY1" inputmask="16"> <bounds x="931.25" y="787.5" width="72.65625" height="84.375" /> </element>
        <element ref="touch_k" inputtag="KEY2" inputmask="16"> <bounds x="1006.25" y="787.5" width="72.65625" height="84.375" /> </element>
        <element ref="touch_l" inputtag="KEY3" inputmask="16"> <bounds x="1081.25" y="787.5" width="72.65625" height="84.375" /> </element>
        <element ref="touch_m" inputtag="KEY0" inputmask="8"> <bounds x="1156.25" y="787.5" width="72.65625" height="84.375" /> </element>
        <element ref="touch_n" inputtag="KEY1" inputmask="8"> <bounds x="1268.75" y="787.5" width="72.65625" height="84.375" /> </element>

        <element ref="hint_haidi_n" id="lamp_hint_haidi">
            <bounds x="1268.75" y="787.5" width="72.65625" height="84.375" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> 
        </element>
        <element ref="hint_duihua_n" id="lamp_hint_duihua">
            <bounds x="1268.75" y="787.5" width="72.65625" height="84.375" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> 
        </element>

        <element ref="hint_bibei_a" id="lamp_hint_bibei">
            <bounds x="256.25" y="787.5" width="72.65625" height="84.375" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> 
        </element>
        <element ref="hint_bibei_c" id="lamp_hint_bibei__1">
            <bounds x="406.25" y="787.5" width="72.65625" height="84.375" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> 
        </element>
        <element ref="hint_bibei_e" id="lamp_hint_bibei__2">
            <bounds x="556.25" y="787.5" width="72.65625" height="84.375" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> 
        </element>
        <element ref="hint_bibei_g" id="lamp_hint_bibei__3">
            <bounds x="706.25" y="787.5" width="72.65625" height="84.375" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> 
        </element>
        <element ref="hint_bibei_m" id="lamp_hint_bibei__4">
            <bounds x="1156.25" y="787.5" width="72.65625" height="84.375" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> 
        </element>
        <element ref="hint_bibei_n" id="lamp_hint_bibei__5">
            <bounds x="1268.75" y="787.5" width="72.65625" height="84.375" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> 
        </element>
    </view>

</mamelayout>
