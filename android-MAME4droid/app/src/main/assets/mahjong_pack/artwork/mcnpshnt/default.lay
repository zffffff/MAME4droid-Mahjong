        <!-- Last Chance A-J 闪灯（竖版 lc_highlight 叠在按键区） -->
        <bezel id="lamp_hint_lc_a" element="lc_highlight_glow"> <bounds x="3" y="1240" width="142" height="200" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> </bezel>
