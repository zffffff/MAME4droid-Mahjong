        <!-- 配牌选择 A-C 闪灯（竖版 glow） -->
        <bezel id="lamp_hint_ws_a" element="lamp_a_glow"> <bounds x="3" y="1240" width="142" height="200" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> </bezel>
