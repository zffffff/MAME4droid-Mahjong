    <element name="hint_notebook_f_glow"> <image file="hint_notebook_f.png" /> </element>
    <element name="hint_notebook_g_glow"> <image file="hint_notebook_g.png" /> </element>

    <!-- 横版选人闪灯（508×240 比例 overlay）；竖版选人 A-D 用上方 lamp_a~d_glow -->
    <element name="character_select_a_glow"> <image file="character_slect_a.png" /> </element>
    <element name="character_select_b_glow"> <image file="character_slect_b.png" /> </element>
    <element name="character_select_c_glow"> <image file="character_slect_c.png" /> </element>
