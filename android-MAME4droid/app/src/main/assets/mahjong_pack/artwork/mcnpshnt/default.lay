    <element name="start_donden_glow"> <image file="start_donden_down.png" /> </element>

    <view name="Portrait_2_Rows">
        <bounds x="0" y="0" width="1000" height="1640" />
        <screen index="0"> <bounds x="0" y="0" width="1000" height="970" /> </screen>
        <bezel element="bg_panel"> <bounds x="0" y="970" width="1000" height="670" /> </bezel>
        
        <bezel element="button_start_donden" inputtag="KEY0" inputmask="32"> <bounds x="3" y="980" width="142" height="130" /> </bezel>
        <bezel element="button_keyin" inputtag="COINS" inputmask="64"> <bounds x="855" y="980" width="142" height="130" /> </bezel>
        <bezel element="button_chi" inputtag="KEY2" inputmask="8"> <bounds x="145" y="1110" width="142" height="130" /> </bezel>
