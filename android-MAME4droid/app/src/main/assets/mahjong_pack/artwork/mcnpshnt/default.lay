    <element name="touch_n"> <image file="touch_up.png" state="0" /> <image file="touch_down.png" state="1" /> </element>
    <!-- 横版字母键松开态：无 Lua=std；有 Lua=touch_up_l（mcnpshnt_letter_vis） -->
    <element name="touch_up_std"> <image file="touch_up.png" state="0" /> </element>
    <element name="touch_up_lua"> <image file="touch_up_l.png" state="0" /> </element>
    <!-- 横版按下反馈：松开透明，松开态由 touch_up_l overlay 负责 -->
    <element name="touch_press"> <image file="touch_nil.png" state="0" /> <image file="touch_down.png" state="1" /> </element>
    <!-- 横版字母区静态提示（兜底，参考 lhb） -->
    <element name="overlay_letters"> <image file="overlay_letters.png" /> </element>

    <!-- 横版狩猎选项 A-D 专用触摸图（537×60，勿用 touch_up 拉伸） -->
    <element name="hunt_touch"> <image file="hunt_touch_up.png" state="0" /> <image file="hunt_touch_up.png" state="1" /> </element>

    <!-- 横版配牌选择 A-C 触摸（松开透明，松开态由 touch_up_l overlay；down 保留按下反馈） -->
    <element name="ws_touch"> <image file="touch_nil.png" state="0" /> <image file="touch_down.png" state="1" /> </element>
    <element name="hint_ws_a_glow"> <image file="ws_a.png" /> </element>
    <element name="hint_ws_b_glow"> <image file="ws_b.png" /> </element>
    <element name="hint_ws_c_glow"> <image file="ws_c.png" /> </element>

    <!-- Last Chance A-J：lc_highlight 34×32 原尺寸闪灯；lc_touch 透明 hitbox -->
    <element name="lc_highlight_glow"> <image file="lc_highlight.png" /> </element>
    <element name="lc_touch"> <image file="touch_up.png" state="0" /> <image file="touch_down.png" state="1" /> </element>

    <element name="lamp_chi_glow"> <image file="chi_glow.png" /> </element>
    <element name="lamp_pon_glow"> <image file="pon_glow.png" /> </element>
    <element name="lamp_kan_glow"> <image file="kan_glow.png" /> </element>
    <element name="lamp_ron_glow"> <image file="ron_glow.png" /> </element>
    
    <!-- 竖版字母键闪灯（common_assets *_glow.png） -->
    <element name="lamp_a_glow"> <image file="a_glow.png" /> </element>
    <element name="lamp_b_glow"> <image file="b_glow.png" /> </element>
    <element name="lamp_c_glow"> <image file="c_glow.png" /> </element>
    <element name="lamp_d_glow"> <image file="d_glow.png" /> </element>
    <element name="lamp_e_glow"> <image file="e_glow.png" /> </element>
    <element name="lamp_f_glow"> <image file="f_glow.png" /> </element>
    <element name="lamp_g_glow"> <image file="g_glow.png" /> </element>

    <!-- 横版狩猎/手帐闪灯（单图 + alpha） -->
    <element name="hint_hunt_a_glow"> <image file="hint_hunt_a.png" /> </element>
    <element name="hint_hunt_b_glow"> <image file="hint_hunt_b.png" /> </element>
    <element name="hint_hunt_c_glow"> <image file="hint_hunt_c.png" /> </element>
