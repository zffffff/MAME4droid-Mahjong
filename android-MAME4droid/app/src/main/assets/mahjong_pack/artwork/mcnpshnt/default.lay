        <bezel id="lamp_hint_notebook_a" element="lamp_a_glow"> <bounds x="3" y="1240" width="142" height="200" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> </bezel>
        <bezel id="lamp_hint_notebook_b" element="lamp_b_glow"> <bounds x="145" y="1240" width="142" height="200" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> </bezel>
        <bezel id="lamp_hint_notebook_c" element="lamp_c_glow"> <bounds x="287" y="1240" width="142" height="200" /> <color state="0" alpha="0.0" /> <color state="1" alpha="1.0" /> </bezel>
