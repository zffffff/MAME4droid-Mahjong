        <bezel element="touch_f" inputtag="KEY1" inputmask="2"> <bounds x="625" y="750" width="80" height="105" /> </bezel>
        <bezel element="touch_g" inputtag="KEY2" inputmask="2"> <bounds x="710" y="750" width="80" height="105" /> </bezel>
        <bezel element="touch_h" inputtag="KEY3" inputmask="2"> <bounds x="795" y="750" width="80" height="105" /> </bezel>
        <bezel element="touch_i" inputtag="KEY0" inputmask="4"> <bounds x="880" y="750" width="80" height="105" /> </bezel>
        <bezel element="touch_j" inputtag="KEY1" inputmask="4"> <bounds x="965" y="750" width="80" height="105" /> </bezel>
