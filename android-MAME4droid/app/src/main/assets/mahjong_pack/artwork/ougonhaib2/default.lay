    <element name="lamp_n_glow"> <image file="n_glow.png" /> </element>

    <view name="Portrait_2_Rows">
        <screen index="0"> <bounds x="0" y="0" width="1000" height="970" /> </screen>
        <bezel element="bg_panel"> <bounds x="0" y="970" width="1000" height="670" /> </bezel>
        
        <bezel element="button_start" inputtag="KEY0" inputmask="32"> <bounds x="3" y="980" width="142" height="130" /> </bezel>
        <bezel element="button_donden" inputtag="KEY4" inputmask="8"> <bounds x="145" y="980" width="142" height="130" /> </bezel>
        <bezel element="button_keyin" inputtag="COINS" inputmask="32"> <bounds x="713" y="980" width="142" height="130" /> </bezel>
        <bezel element="button_bet" inputtag="KEY1" inputmask="32"> <bounds x="855" y="980" width="142" height="130" /> </bezel>
        <bezel element="button_chi" inputtag="KEY2" inputmask="8"> <bounds x="145" y="1110" width="142" height="130" /> </bezel>
        <bezel element="button_pon" inputtag="KEY3" inputmask="8"> <bounds x="287" y="1110" width="142" height="130" /> </bezel>
        <bezel element="button_kan" inputtag="KEY0" inputmask="16"> <bounds x="429" y="1110" width="142" height="130" /> </bezel>
        <bezel element="button_reach" inputtag="KEY1" inputmask="16"> <bounds x="571" y="1110" width="142" height="130" /> </bezel>
        <bezel element="button_ron" inputtag="KEY2" inputmask="16"> <bounds x="713" y="1110" width="142" height="130" /> </bezel>
        
        <bezel element="button_a" inputtag="KEY0" inputmask="1"> <bounds x="3" y="1240" width="142" height="200" /> </bezel>
        <bezel element="button_b" inputtag="KEY1" inputmask="1"> <bounds x="145" y="1240" width="142" height="200" /> </bezel>
        <bezel element="button_c" inputtag="KEY2" inputmask="1"> <bounds x="287" y="1240" width="142" height="200" /> </bezel>
        <bezel element="button_d" inputtag="KEY3" inputmask="1"> <bounds x="429" y="1240" width="142" height="200" /> </bezel>
        <bezel element="button_e" inputtag="KEY0" inputmask="2"> <bounds x="571" y="1240" width="142" height="200" /> </bezel>
        <bezel element="button_f" inputtag="KEY1" inputmask="2"> <bounds x="713" y="1240" width="142" height="200" /> </bezel>
        <bezel element="button_g" inputtag="KEY2" inputmask="2"> <bounds x="855" y="1240" width="142" height="200" /> </bezel>
        <bezel element="button_h" inputtag="KEY3" inputmask="2"> <bounds x="3" y="1440" width="142" height="200" /> </bezel>
        <bezel element="button_i" inputtag="KEY0" inputmask="4"> <bounds x="145" y="1440" width="142" height="200" /> </bezel>
        <bezel element="button_j" inputtag="KEY1" inputmask="4"> <bounds x="287" y="1440" width="142" height="200" /> </bezel>
        <bezel element="button_k" inputtag="KEY2" inputmask="4"> <bounds x="429" y="1440" width="142" height="200" /> </bezel>
        <bezel element="button_l" inputtag="KEY3" inputmask="4"> <bounds x="571" y="1440" width="142" height="200" /> </bezel>
        <bezel element="button_m" inputtag="KEY0" inputmask="8"> <bounds x="713" y="1440" width="142" height="200" /> </bezel>
        <bezel element="button_n" inputtag="KEY1" inputmask="8"> <bounds x="855" y="1440" width="142" height="200" /> </bezel>

        <bezel id="lamp_hint_n" element="lamp_n_glow">
            <bounds x="855" y="1440" width="142" height="200" /> 
            <color state="0" alpha="0.0" /> 
            <color state="1" alpha="1.0" /> 
        </bezel>
    </view>

    <view name="Landscape_Touch_Screen">
        <bounds x="0" y="0" width="1600" height="900" />
        
        <bezel element="bg_landscape"> 
            <bounds x="0" y="0" width="1600" height="900" /> 
        </bezel>
        
        <screen index="0"> <bounds x="200" y="0" width="1200" height="900" /> </screen>

        <bezel element="button_keyin" inputtag="COINS" inputmask="32"> <bounds x="58" y="770" width="142" height="130" /> </bezel>
        <bezel element="button_bet" inputtag="KEY1" inputmask="32"> <bounds x="58" y="640" width="142" height="130" /> </bezel>
